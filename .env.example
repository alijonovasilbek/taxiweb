# ============================
# SERVER
# ============================
NODE_ENV=development
PORT=3000
PASSENGER_APP_URL=http://localhost:5173
DRIVER_APP_URL=http://localhost:5174
ADMIN_URL=http://localhost:5175

# ============================
# DATABASE
# ============================
DATABASE_URL=postgresql://taxigo:password@localhost:5432/taxigo_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taxigo_db
DB_USER=taxigo
DB_PASSWORD=your_strong_password

# ============================
# REDIS
# ============================
REDIS_URL=redis://localhost:6379

# ============================
# JWT
# ============================
JWT_SECRET=your_very_long_random_secret_key_here_minimum_64_chars_xxxxxxxxx
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=separate_admin_jwt_secret_also_minimum_64_chars_xxxxxxxxxx

# ============================
# TELEGRAM
# ============================
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-xxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=random_webhook_secret_string_32_chars
TELEGRAM_PAYMENT_TOKEN=your_telegram_payment_provider_token
ADMIN_TELEGRAM_IDS=123456789,987654321

# ============================
# YANDEX MAPS
# ============================
YANDEX_MAPS_API_KEY=your_yandex_maps_js_api_key
YANDEX_GEOCODER_API_KEY=your_yandex_geocoder_api_key
YANDEX_ROUTER_API_KEY=your_yandex_router_api_key

# ============================
# PAYME
# ============================
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key
PAYME_TEST_SECRET_KEY=your_payme_test_secret_key
PAYME_IS_TEST=true
PAYME_WEBHOOK_URL=https://your-domain.uz/api/payments/payme/verify

# ============================
# CLICK
# ============================
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SERVICE_ID=your_click_service_id
CLICK_SECRET_KEY=your_click_secret_key
CLICK_WEBHOOK_URL=https://your-domain.uz/api/payments/click/verify

# ============================
# FILE UPLOAD
# ============================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ============================
# RATE LIMITING
# ============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================
# SOCKET.IO
# ============================
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
DRIVER_LOCATION_TTL=30

# ============================
# LOGGING
# ============================
LOG_LEVEL=debug
